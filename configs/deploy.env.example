# injection_guard 本地部署参数示例。复制为 configs/deploy.env 并按需修改。
#
# 仅被 injection-guard-deploy 命令（cli/deploy.py）读取。该命令按端口派生并注入各子
# 服务的连接 URL 环境变量（APP_PORT / *_API_URL），再以子进程方式拉起各服务。
# 优先级：环境变量 > configs/deploy.env > 默认值。
# 提示：裸变量名（HOST / MODE / WORKERS / GPU_IDS）可用 shell 环境临时覆盖，
#       例如 WORKERS=8 injection-guard-deploy。

# ── 模型路径（显式指定，按部署位置修改；不做根目录派生）──
INPUT_MODEL_PATH=./models/LLM/Qwen_prompt_injection
OUTPUT_MODEL_PATH=./models/LLM/qwen3-0.6b
EMBED_MODEL_PATH=./models/Embedding/Qwen3-Embedding-0.6B
CHAT_MODEL_PATH=./models/LLM/qwen3-0.6b

# ── 绑定 / 访问地址 ──
# 子服务绑定 Host（默认仅本机）；让本地推理服务对外监听可设 0.0.0.0
HOST=localhost
# 派生 *_API_URL 用的主机名（勿用 0.0.0.0；绑定地址与访问地址分离）
URL_HOST=localhost

# ── 端口（端口单一来源，deploy 命令据此派生 APP_PORT 与各 *_API_URL）──
DEFENSE_PORT=8099
INPUT_PORT=8094
OUTPUT_PORT=8095
EMBED_PORT=8096
CHAT_PORT=8097

# ── 推理服务参数 ──
# uvicorn worker 数（LLM 服务用；各 worker 独立加载模型副本）
WORKERS=1
# 模型加载模式 full / lora
MODE=full
# 单个推理请求最大等待+执行时间（秒）
REQUEST_TIMEOUT=300
# ── GPU 分配 ──
# 全局可用 GPU 列表（各服务共用的回退值），如 0,1,2,3；留空用全部可见 GPU。
# ⚠️ 只设这一个值会让 input/output/chat/embed 都挑到同一张卡 → 24G 卡上必然 OOM，
#    多卡机器请按下例**按服务钉卡**。
# GPU_IDS=
#
# 按服务钉卡（留空则回退到 GPU_IDS，再回退到全部可见 GPU）：
# INPUT_GPU_IDS=1    # 输入检测 LLM（Qwen_prompt_injection ≈ 9.4G）
# OUTPUT_GPU_IDS=2   # 输出检测 LLM（Qwen3-8b ≈ 16G）
# EMBED_GPU_IDS=3    # Embedding（≈ 1.2G）
# CHAT_GPU_IDS=      # 本地聊天模型（DEPLOY_LOCAL_CHAT=false 时无需）
#
# 输入检测 BERT 分类器池用卡（注入子进程 INPUT_DETECTOR_GPU_IDS；留空 = 按空闲显存自动选卡）：
# BERT_GPU_IDS=3     # 与 Embedding 同卡约 4.5G，或单独给一张空闲卡

# ── 可选服务是否本地部署 ──
# Embedding（RAG 增强所需）
# true ：本地启动 Embedding，并覆盖 EMBED_API_URL 指向本地端口（默认）
# false：不启动；用 .env 里配置的 EMBED_API_URL（外部 Embedding），或 RAG 关闭时无需
DEPLOY_LOCAL_EMBED=true
# 聊天 LLM
# false：用 .env 里的云端 CHAT_API_URL / CHAT_API_KEY（无需本地聊天服务，默认）
# true ：本地启动聊天 LLM，并覆盖 CHAT_API_URL 指向本地端口
DEPLOY_LOCAL_CHAT=false
