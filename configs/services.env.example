# injection_guard 运行时参数示例。复制为 configs/services.env 并按需修改。
#
# 与仓库根 .env 一起被 config.Settings 读取（本文件覆盖 .env）；其中
# `<服务>_API_SERVER_*` 由 serve_llm 按 --service 读取（见 config.InferenceSettings.for_service）。
# 优先级：环境变量 > configs/services.env > .env > 默认值。


# ══════════════════ 输入检测 ══════════════════

# 输入编码截断上限（token）
INPUT_API_SERVER_MAX_INPUT_TOKENS=4096
# 是否加载 BERT 分类器组参与输入检测：false（默认）= 只走 8094 的 LLM 复审；
# true = 加载 models/BERT 下所有分类器做集成投票，置信度不足时再触发 LLM 复审。
# 注意：模型加载由本开关在服务启动时决定，请求体 use_bert 只能在此基础上逐次关闭。
ENABLE_BERT=false
# -- 并发 / 超时（默认即可）--
# 输入检测并发上限（默认 GPU 数×副本数）；获取名额超时（秒，默认 30）
# INPUT_MAX_CONCURRENCY=
# INPUT_ACQUIRE_TIMEOUT=30
# -- GPU / 进程（默认即可）--
# 输入检测（BERT）GPU 列表 / 每卡副本数（默认全部可见 GPU / 1）
# INPUT_DETECTOR_GPU_IDS=0,1,2,3
# INPUT_DETECTOR_REPLICAS_PER_GPU=1
# 推理队列最大长度，超过返回 503；0=不限制（默认 32）
# INPUT_API_SERVER_MAX_QUEUE_SIZE=32
# 是否跨多 GPU 切分模型（默认 false，每 worker 绑定单卡）
# INPUT_API_SERVER_SPLIT_ACROSS_GPUS=false
# 可用 GPU 列表 / GPU 分配命名空间（多进程共享时隔离）/ 显存占比上限
# INPUT_API_SERVER_GPU_IDS=0,1,2,3
# INPUT_API_SERVER_GPU_NAMESPACE=
# INPUT_API_SERVER_MEMORY_FRACTION=0.9
# 每完成 N 个请求清一次 CUDA 缓存（默认 32）；每请求后都清（默认 false）
# INPUT_API_SERVER_EMPTY_CACHE_EVERY=32
# INPUT_API_SERVER_EMPTY_CACHE_AFTER_REQUEST=false

# ══════════════════ 输出检测 ══════════════════
# -- 影响检测的项 --
OUTPUT_API_SERVER_MAX_INPUT_TOKENS=4096
# 流式生成期间的「增量输出检测」间隔（token 估算值）：每累计约这么多 token 检测一次已生成
# 内容，命中不安全立即中断生成；0 = 关闭（只在生成结束后检测一次）。
# 注意：输入高置信跳过输出检测（SKIP_OUTPUT_WHEN_HIGH_CONFIDENCE）时不触发增量检测。
OUTPUT_DETECT_INTERVAL_TOKENS=512
# -- 并发 / 超时（默认即可）--
# 输出检测并发上限（默认 GPU 数×副本数）；获取名额超时（秒，默认 30）
# OUTPUT_MAX_CONCURRENCY=
# OUTPUT_ACQUIRE_TIMEOUT=30
# 单条宪法规则 LLM 调用超时（秒，默认 60）
# OUTPUT_DETECTOR_TIMEOUT=60
# -- GPU / 进程（默认即可）--
# OUTPUT_API_SERVER_MAX_QUEUE_SIZE=32
# OUTPUT_API_SERVER_SPLIT_ACROSS_GPUS=false
# OUTPUT_API_SERVER_GPU_IDS=0,1,2,3
# OUTPUT_API_SERVER_GPU_NAMESPACE=
# OUTPUT_API_SERVER_MEMORY_FRACTION=0.9
# OUTPUT_API_SERVER_EMPTY_CACHE_EVERY=32
# OUTPUT_API_SERVER_EMPTY_CACHE_AFTER_REQUEST=false

# ══════════════════ Embedding / RAG ══════════════════
# -- 影响检测的项 --
# 检索 Top-K（注入的 few-shot 示例条数）
RAG_TOP_K=2
# -- 超时 / GPU（默认即可）--
# Embedding GPU 列表 / 单请求超时（秒，默认 60）
# EMBED_GPU_IDS=0,1,2,3
# EMBED_GPU_NAMESPACE=
# EMBED_REQUEST_TIMEOUT=60

# ══════════════════ 聊天 ══════════════════
# -- 应用侧（默认即可）--
# 聊天超时（默认 120）；并发上限（默认 GPU 数×副本数）；获取名额超时（秒，默认 120）
# CHAT_TIMEOUT=120
# CHAT_MAX_CONCURRENCY=
# CHAT_ACQUIRE_TIMEOUT=120
# -- 聊天 LLM 推理 --
# 输入编码截断上限（默认 4096）
# CHAT_API_SERVER_MAX_INPUT_TOKENS=4096

# CHAT_API_SERVER_MAX_QUEUE_SIZE=32
# CHAT_API_SERVER_SPLIT_ACROSS_GPUS=false
# CHAT_API_SERVER_GPU_IDS=0,1,2,3
# CHAT_API_SERVER_GPU_NAMESPACE=
# CHAT_API_SERVER_MEMORY_FRACTION=0.9
# CHAT_API_SERVER_EMPTY_CACHE_EVERY=32
# CHAT_API_SERVER_EMPTY_CACHE_AFTER_REQUEST=false

# ══════════════════ 请求时参数（前端设置面板提供，**不写入本文件**）══════════════════
# 这些随每次请求发送，缺省回落到 config.py 中 Settings 的默认值：
#   use_rag                        RAG 增强开关（默认 false）
#   sensitivity                    输入检测敏感度 low/medium/high（默认取 low）
#   skip_output_when_high_confidence  高置信跳过输出检测（默认 true）
#   safe_skip_threshold            跳过阈值 0~1（默认 0.5）
#   temperature / max_tokens       聊天生成参数（默认 0.7 / 1024）
