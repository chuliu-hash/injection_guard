# injection_guard 配置示例。复制为 .env 并按需修改。
# 字段名大小写不敏感；此处用大写（等价于 config.py 中的小写下划线字段）。

# ── 应用 ──
APP_HOST=0.0.0.0
APP_PORT=8099
APP_DEBUG=false
APP_BACKLOG=128
LOG_LEVEL=INFO

# ── Web 前端 / 跨域 ──
# 前端构建产物目录（存在时由防御 API 托管 SPA）；留空默认 <repo>/frontend/dist
# FRONTEND_DIST_DIR=./frontend/dist
# 逗号分隔的允许跨域来源；留空则不加 CORS 中间件（同源部署无需）
# CORS_ORIGINS=http://localhost:5173

# ── 路径 ──
# 仓库内随代码分发的数据目录（含 CritiqueRequests.json）
RESOURCES_DIR=./resources
# 外部模型权重根目录（不入库）
MODEL_ROOT=./models
# 以下留空则按 MODEL_ROOT 派生；需要时显式覆盖
# CRITIQUE_REQUESTS_PATH=./resources/CritiqueRequests.json
# BERT_MODEL_DIR=./models/Prompt_Injection/model/BERT
# RAG_DB_PATH=./models/Prompt_Injection/overthink_prompt.json
# RAG_EMBED_PATH=./models/Prompt_Injection/safety_context_compiled.pt

# ── 输入检测 ──
FIXED_SENSITIVITY=low
SAFE_SKIP_THRESHOLD=0.5
SKIP_OUTPUT_WHEN_HIGH_CONFIDENCE=true
# INPUT_MAX_CONCURRENCY / OUTPUT_MAX_CONCURRENCY 留空则 = GPU 数 × 每卡副本数
# INPUT_MAX_CONCURRENCY=8
# OUTPUT_MAX_CONCURRENCY=4
INPUT_ACQUIRE_TIMEOUT=30
OUTPUT_ACQUIRE_TIMEOUT=30
# INPUT_DETECTOR_GPU_IDS=0,1,2,3
INPUT_DETECTOR_REPLICAS_PER_GPU=1
# 下游服务统一为 base URL（形如 http://host:port/v1），端点路径由代码拼接
INPUT_DETECTOR_API_URL=http://127.1.1.1:8094/v1
INPUT_DETECTOR_API_MODEL=Qwen3-input

# ── 输出检测 ──
OUTPUT_DETECTOR_API_URL=http://127.1.1.1:8095/v1
OUTPUT_DETECTOR_MODEL=Qwen_output
OUTPUT_DETECTOR_TIMEOUT=60
OUTPUT_DETECTOR_MAX_TOKENS=8

# ── 普通聊天 LLM（请求未带 model_response 时用于生成）──
CHAT_API_URL=http://127.1.1.1:8097/v1
CHAT_MODEL=Qwen3-chat
CHAT_TIMEOUT=120
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.7
# CHAT_MAX_CONCURRENCY=8
CHAT_ACQUIRE_TIMEOUT=120

# ── Embedding / RAG ──
EMBED_API_URL=http://127.1.1.1:8096/v1
EMBED_MODEL_NAME=embedding-model
# EMBED_GPU_IDS=0,1,2,3
EMBED_REQUEST_TIMEOUT=60
# RAG 增强：全局开关（默认关），请求体 use_rag 可覆盖
ENABLE_RAG=false
RAG_TOP_K=2

# ── 推理服务（services/llm_server.py）──
# API_SERVER_GPU_IDS=0,1,2,3
API_SERVER_SPLIT_ACROSS_GPUS=false
API_SERVER_MAX_QUEUE_SIZE=32
API_SERVER_MAX_INPUT_TOKENS=2048
API_SERVER_MAX_NEW_TOKENS=256
# API_SERVER_MEMORY_FRACTION=0.9
API_SERVER_EMPTY_CACHE_EVERY=32
API_SERVER_EMPTY_CACHE_AFTER_REQUEST=false
