# injection_guard 配置示例（仅「访问项目 / 资源路径 / 连接模型」必需项）。
# 复制为 .env 并按需修改。
#
# 其余配置已拆分到 configs/，需要时复制对应 .example 为同名文件：
#   - configs/services.env   只放影响检测的关键项，按服务分块（输入 / 输出 / Embedding / 聊天）；
#                            其余可调项见同名 .example（注释形式）
#   - configs/deploy.env     本地部署（模型路径 / 端口 / workers）—— injection-guard-deploy 读取
# 优先级（高 → 低）：环境变量 > configs/*.env > .env > 代码默认值。
# 字段名大小写不敏感；此处用大写（等价于 config.py 中的小写下划线字段）。

# ── 应用 ──
APP_HOST=0.0.0.0
# 由 injection-guard-deploy 按 DEFENSE_PORT 导出；默认 8099
# APP_PORT=8099
APP_DEBUG=false
APP_BACKLOG=128
LOG_LEVEL=INFO

# ── 会话持久化（多用户隔离）──
# PostgreSQL 是唯一支持的数据库后端；会话 / 消息 / 检测记录与 LangGraph 检查点共用此连接。
# 未指定库名时，libpq 默认连接与用户名同名的数据库（这里是 chuliu）。
DATABASE_URL=postgresql://chuliu:123456@127.0.0.1:5432/injection_guard
# 会话标题自动生成的最大长度（取首条用户消息前若干字符）
# SESSION_TITLE_MAX_LEN=20

# ── 登录鉴权（JWT + bcrypt）──
# 签名密钥：**生产必须显式设置**，否则沿用不安全的开发默认值并在启动时告警。
# 生成：openssl rand -hex 32
JWT_SECRET_KEY=please-change-me-openssl-rand-hex-32
# access token 有效期（分钟）与 refresh token 有效期（天）
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# HTTPS 部署置 true（刷新 Cookie 仅经 TLS 传输）
# COOKIE_SECURE=false
# 是否允许自助注册（生产可关闭，改由管理员建号）
# ALLOW_REGISTRATION=true
# 密码最短长度
# PASSWORD_MIN_LENGTH=8

# ── Web 前端 / 跨域 ──
# 前端构建产物目录（存在时由防御 API 托管 SPA）；留空默认 <repo>/frontend/dist
# FRONTEND_DIST_DIR=./frontend/dist
# 逗号分隔的允许跨域来源；留空则不加 CORS 中间件（同源部署无需）
# CORS_ORIGINS=http://localhost:5173

# ── 路径（获取资源）──
# BERT 分类模型目录
BERT_MODEL_DIR=./models/BERT
# RAG 知识库目录：读取其中所有 *.json（每条含 prompt / safe_response）；
# 任意文件新增 / 删除 / 修改都会按内容指纹自动重建 Milvus 集合。
RAG_DIR=./resources/rag
# Milvus 服务地址 / 集合名（需先启动 Milvus，默认监听 19530）。
# 应用在远程服务器、Milvus 在本机时，改为本机对服务器可达的局域网 IP，不能用 localhost。
MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=injection_guard_rag
# RAG_META_PATH=./resources/rag_milvus.json
# 宪法规则文件（默认 <repo>/resources/CritiqueRequests.json），需要时覆盖
# CRITIQUE_REQUESTS_PATH=./resources/CritiqueRequests.json

# ── 连接模型 ──
# 下游服务统一为 base URL（形如 http://host:port/v1），端点路径由代码拼接。
# 由 injection-guard-deploy 按端口变量导出覆盖；此处为不部署本地服务时的默认值。

# 输入检测 LLM
INPUT_DETECTOR_API_URL=http://localhost:8094/v1
INPUT_DETECTOR_API_MODEL=Qwen-input

# 输出检测 LLM
OUTPUT_DETECTOR_API_URL=http://localhost:8095/v1
# 本地留空即可；云端填 key
# OUTPUT_DETECTOR_API_KEY=
OUTPUT_DETECTOR_MODEL=Qwen-output

# 普通聊天 LLM
# 本地：CHAT_API_URL=http://localhost:8097/v1
# 云端：填云厂商 base URL 与 CHAT_API_KEY，例如
#   CHAT_API_URL=https://api.deepseek.com/v1
#   CHAT_API_KEY=sk-xxx
#   CHAT_MODEL=deepseek-chat
CHAT_API_URL=http://localhost:8097/v1
CHAT_MODEL=
CHAT_API_KEY=
# 以下生成参数只作为服务端默认值；前端设置页可在运行时逐请求覆盖。
# CHAT_TEMPERATURE=0.7
# CHAT_TOP_P=0.9
# CHAT_MAX_TOKENS=1024
# CHAT_FREQUENCY_PENALTY=0.0
# CHAT_PRESENCE_PENALTY=0.0
# CHAT_SEED=

# Embedding（RAG 增强所需）
EMBED_API_URL=http://localhost:8096/v1
EMBED_MODEL_NAME=Qwen-embedding
